                    <HorizontalAlignment x:Key="HorizontalContentAlignment">Left</HorizontalAlignment>
                    <sys:Boolean x:Key="ListBoxCanContentScroll">True</sys:Boolean>
                    <SolidColorBrush x:Key="ListBox_Foreground" Color="Red" />

                    <!--Border-->
                    <Thickness x:Key="Border_ListBoxBorderThemeThickness">0</Thickness>
                    <SolidColorBrush x:Key="Border_ListBoxBackground" Color="#0DFFFFFF" />
